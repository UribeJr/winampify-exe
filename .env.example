# Copy to .env (gitignored) and fill in. Everything here is read only by the Express server;
# none of it is bundled into the browser (Vite only exposes VITE_-prefixed variables).

# Users pick Navidrome or Spotify on the sign-in screen; this only sets which one is pre-selected.
# A service shows up greyed out until its settings below are filled in.
MUSIC_PROVIDER=navidrome

# --- Navidrome / OpenSubsonic ---
# Base URL of your Navidrome server, as reachable from the machine running `npm run dev`
NAVIDROME_URL=http://your-navidrome-host:4533
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
# Optional: name shown in the UI ("Connect to …") and the player name Navidrome lists
# NAVIDROME_NAME=My Music Server
# NAVIDROME_CLIENT_ID=winampify

# --- Server ---
PORT=3001
# Dev listens on 127.0.0.1 only. Set HOST=0.0.0.0 (and run `npm run client -- --host`)
# to use the player from other devices on your network - anyone on that network can then play your library.
# HOST=127.0.0.1

# --- Spotify (only when MUSIC_PROVIDER=spotify) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
# Production only:
# FRONTEND_URL=https://your-app.example.com
# CLIENT_ORIGIN=https://your-app.example.com
